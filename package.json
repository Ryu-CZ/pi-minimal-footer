{
  "name": "pi-minimal-footer",
  "version": "0.16.0",
  "description": "An opinionated minimal Pi footer - one-line status bar showing subscription usage, path, status, model and context.",
  "keywords": [
    "footer",
    "minimal",
    "usage",
    "limits",
    "status-bar",
    "one-line",
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "homepage": "https://github.com/Ryu-CZ/pi-minimal-footer#readme",
  "bugs": {
    "url": "https://github.com/Ryu-CZ/pi-minimal-footer/issues"
  },
  "license": "MIT",
  "author": "Ryu-CZ <thandeus@gmail.com> (https://github.com/Ryu-CZ)",
  "files": [
    "CHANGELOG.md",
    "extensions/",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryu-CZ/pi-minimal-footer.git"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "coverage": "JITI_SOURCE_MAPS=1 JITI_FS_CACHE=0 node --enable-source-maps --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include-all --test-coverage-include='**/extensions/**/*.ts' --test-reporter=spec --test-reporter=./scripts/coverage-reporter.mjs --test-reporter-destination=stdout --test-reporter-destination=coverage.svg tests/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.3 <1.6.0",
    "@earendil-works/pi-tui": ">=1.0.3 <1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/Ryu-CZ/pi-minimal-footer/main/media/pi-preview.png"
  }
}
